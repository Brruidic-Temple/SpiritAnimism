<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>10</LangVersion>
    <AssemblyName>SpiritAnimism</AssemblyName>
    <RootNamespace>SpiritAnimism</RootNamespace>
    <Version>0.4.0</Version>
    <Authors>Brruid</Authors>
    <ThunderstoreTeam>Brruidic_Temple</ThunderstoreTeam>
    <PackageDescription>Spirit Caller summons your way: tint or natural look per animal, pick what the staff summons, a summon panel and a dismiss key. Client-side.</PackageDescription>
    <WebsiteUrl>https://github.com/Brruidic-Temple/SpiritAnimism</WebsiteUrl>
    <BepInExPackDependency>denikson-BepInExPack_Valheim-5.4.2351</BepInExPackDependency>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <DebugType>portable</DebugType>

    <!-- Override on the command line with -p:ValheimManaged=... / -p:BepInExCore=... / -p:PluginDeployDir=... -->
    <ValheimManaged Condition="'$(ValheimManaged)' == ''">$(HOME)/.local/share/Steam/steamapps/common/Valheim/valheim_Data/Managed</ValheimManaged>
    <GaleProfile Condition="'$(GaleProfile)' == ''">$(HOME)/.var/app/com.kesomannen.gale/data/com.kesomannen.gale/valheim/profiles/TestDruidTextures</GaleProfile>
    <BepInExCore Condition="'$(BepInExCore)' == ''">$(GaleProfile)/BepInEx/core</BepInExCore>
    <PluginDeployDir Condition="'$(PluginDeployDir)' == ''">$(GaleProfile)/BepInEx/plugins/Brruid-SpiritAnimism</PluginDeployDir>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="src/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="BepInEx" HintPath="$(BepInExCore)/BepInEx.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(BepInExCore)/0Harmony.dll" Private="false" />
    <Reference Include="assembly_valheim" HintPath="$(ValheimManaged)/assembly_valheim.dll" Private="false" />
    <Reference Include="assembly_utils" HintPath="$(ValheimManaged)/assembly_utils.dll" Private="false" />
    <Reference Include="assembly_guiutils" HintPath="$(ValheimManaged)/assembly_guiutils.dll" Private="false" />
    <Reference Include="UnityEngine" HintPath="$(ValheimManaged)/UnityEngine.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(ValheimManaged)/UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="UnityEngine.UI" HintPath="$(ValheimManaged)/UnityEngine.UI.dll" Private="false" />
    <Reference Include="UnityEngine.UIModule" HintPath="$(ValheimManaged)/UnityEngine.UIModule.dll" Private="false" />
    <Reference Include="UnityEngine.TextRenderingModule" HintPath="$(ValheimManaged)/UnityEngine.TextRenderingModule.dll" Private="false" />
    <Reference Include="Unity.TextMeshPro" HintPath="$(ValheimManaged)/Unity.TextMeshPro.dll" Private="false" />
  </ItemGroup>

  <Target Name="DeployToGaleProfile" AfterTargets="Build" Condition="'$(NoDeploy)' != 'true'">
    <MakeDir Directories="$(PluginDeployDir)" />
    <Copy SourceFiles="$(TargetPath);$(TargetDir)$(AssemblyName).pdb" DestinationFolder="$(PluginDeployDir)" SkipUnchangedFiles="true" />
    <Message Importance="high" Text="Deployed $(AssemblyName).dll to $(PluginDeployDir)" />
  </Target>

  <!-- dotnet build -c Release -t:Package  ->  dist/SpiritAnimism-<version>.zip, Thunderstore layout. -->
  <Target Name="Package" DependsOnTargets="Build">
    <PropertyGroup>
      <PackageStaging>$(MSBuildProjectDirectory)/obj/package</PackageStaging>
      <PackageZip>$(MSBuildProjectDirectory)/dist/$(AssemblyName)-$(Version).zip</PackageZip>
    </PropertyGroup>
    <Error Condition="!Exists('$(MSBuildProjectDirectory)/package/icon.png')" Text="package/icon.png is missing (256x256 PNG required by Thunderstore)" />
    <RemoveDir Directories="$(PackageStaging)" />
    <MakeDir Directories="$(PackageStaging)/plugins;$(MSBuildProjectDirectory)/dist" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(PackageStaging)/plugins" />
    <Copy SourceFiles="README.md;CHANGELOG.md;package/icon.png" DestinationFolder="$(PackageStaging)" />
    <WriteLinesToFile File="$(PackageStaging)/manifest.json" Overwrite="true" Lines="{
  &quot;name&quot;: &quot;$(AssemblyName)&quot;,
  &quot;version_number&quot;: &quot;$(Version)&quot;,
  &quot;website_url&quot;: &quot;$(WebsiteUrl)&quot;,
  &quot;description&quot;: &quot;$(PackageDescription)&quot;,
  &quot;dependencies&quot;: [ &quot;$(BepInExPackDependency)&quot; ]
}" />
    <Delete Files="$(PackageZip)" />
    <ZipDirectory SourceDirectory="$(PackageStaging)" DestinationFile="$(PackageZip)" />
    <Message Importance="high" Text="Packaged $(PackageZip) for team $(ThunderstoreTeam)" />
  </Target>

</Project>
